<?xml version='1.0' encoding='utf-8'?>
<component type="desktop-application">
  <id>@APP_ID@</id>
  <name>Vivid Gradience</name>
  <summary>Change the look of Adwaita, with ease</summary>
  <developer_name>superuser-miguel</developer_name>
  <launchable type="desktop-id">@APP_ID@.desktop</launchable>
  <metadata_license>CC-BY-SA-4.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <update_contact>https://github.com/superuser-miguel</update_contact>
  <content_rating type="oars-1.1"/>

  <branding>
    <color type="primary" scheme_preference="light">#b9a6f2</color>
    <color type="primary" scheme_preference="dark">#2d2140</color>
  </branding>

  <description>
    <p>Vivid Gradience is a tool for customizing Libadwaita applications and the adw-gtk3 theme.</p>
    <p>The main features of Vivid Gradience include the following:</p>
    <ul>
      <li>Recolor any part of the Adwaita palette</li>
      <li>Generate a Material You color scheme from your wallpaper, with scheme variants and contrast</li>
      <li>Start from 50+ ready-made color schemes in a visual gallery, grouped by family</li>
      <li>Create, save and share presets</li>
      <li>Extend styling with custom CSS</li>
    </ul>
  </description>

  <screenshots>
    <screenshot type="default" width="1122" height="822">
      <caption>Screenshot of "Colors" Tab of Main UI</caption>
      <image type="source">https://raw.githubusercontent.com/GradienceTeam/Design/main/Screenshots/Appdata/main-ui-colors.png</image>
    </screenshot>

    <screenshot width="1122" height="822">
      <caption>Screenshot of "Monet" Tab of Main UI</caption>
      <image type="source">https://raw.githubusercontent.com/GradienceTeam/Design/main/Screenshots/Appdata/main-ui-monet.png</image>
    </screenshot>

    <screenshot width="1122" height="822">
      <caption>Screenshot of "Advanced" Tab of Main UI</caption>
      <image type="source">https://raw.githubusercontent.com/GradienceTeam/Design/main/Screenshots/Appdata/main-ui-advanced.png</image>
    </screenshot>

    <screenshot width="772" height="622">
      <caption>Screenshot of "Installed" Tab of Preset Manager</caption>
      <image type="source">https://raw.githubusercontent.com/GradienceTeam/Design/main/Screenshots/Appdata/preset-manager-installed.png</image>
    </screenshot>

    <screenshot width="772" height="622">
      <caption>Screenshot of "Explore" Tab of Preset Manager</caption>
      <image type="source">https://raw.githubusercontent.com/GradienceTeam/Design/main/Screenshots/Appdata/preset-manager-explore.png</image>
    </screenshot>
  </screenshots>

  <url type="homepage">@PROJECT_URL@</url>
  <url type="bugtracker">@BUGTRACKER_URL@</url>
  <url type="help">@HELP_URL@</url>
  <url type="translate">@TRANSLATE_URL@</url>
  <url type="vcs-browser">@PROJECT_URL@</url>

  <kudos>
    <kudo>HiDpiIcon</kudo>
    <kudo>ModernToolkit</kudo>
  </kudos>

  <custom>
    <value key="Purism::form_factor">mobile</value>
  </custom>

  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </recommends>

  <releases>
    <release version="0.4.0" date="2026-07-29" type="stable">
      <description translate="no">
        <p>GNOME Shell theming works again, on any Shell version, and applies without logging out.</p>
        <ul>
          <li>The Shell engine no longer ships a copy of GNOME's stylesheet sources per release, which is what limited it to GNOME 44. It recolors the stylesheet your installed Shell already has, so it follows your system rather than a list of known versions</li>
          <li>Applying a Shell theme takes effect on the running session immediately</li>
          <li>Shell accent colors are no longer limited to the nine the system offers</li>
          <li>Bluebell and Lilac Mist were close enough to read as the same scheme; Bluebell now leans to a deeper cyan and Lilac Mist to a carbazole violet</li>
          <li>Fixed light color schemes rendering the Shell in flat grey</li>
        </ul>
      </description>
    </release>
    <release version="0.3.0" date="2026-07-28" type="stable">
      <description translate="no">
        <p>Twenty-three new color schemes, and a live preview that checks contrast.</p>
        <ul>
          <li>New Pastel family: Cotton Candy, Sea Glass, Powder Puff, Lilac Mist, Peach Fizz, Buttercream, Sage Linen, and Bluebell</li>
          <li>New Neon family: Neon Tokyo, Vaporwave, Acid Rave, Cyberlime, Neon Tangerine, Voltage, Ultraviolet, and Infrared</li>
          <li>New Casts family: Eminence, Hatred, Daybreak, Fear, Conquest, Agony, and Rot, derived from source color palettes</li>
          <li>76 bundled color schemes in total, with the original families leading the gallery</li>
          <li>A live preview in the Colors tab that redraws as you edit and flags any text below the WCAG AA contrast minimum</li>
          <li>Every status and accent label across the bundled schemes now meets WCAG AA, without altering any scheme's own colors</li>
          <li>Fixed the first-run welcome greeting wrapping in the middle of the app name</li>
        </ul>
      </description>
    </release>
    <release version="0.2.0" date="2026-07-27" type="stable">
      <description translate="no">
        <p>A Material You wallpaper engine and a fresh look.</p>
        <ul>
          <li>Monet now generates dynamic Material You schemes, with nine style variants (Vibrant, Tonal Spot, Expressive, and more) and a contrast control</li>
          <li>New Chip Cascade application icon</li>
          <li>Install and stay current from a signed, auto-updating Flatpak repo</li>
          <li>Lighter dependencies: wallpaper loading moved to GdkPixbuf, dropping svglib and reportlab</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-07-25" type="stable">
      <description translate="no">
        <p>More built-in themes and a refined preset gallery.</p>
        <ul>
          <li>New Arc theme family: Arc, Arc Darker, Arc Dark, Arc Gotham, and Arc Grey (light and dark)</li>
          <li>New Matcha theme family: Sea, Azul, Aliz, and Pueril, each in light and dark</li>
          <li>53 bundled color schemes, now grouped into family sections in the gallery</li>
          <li>Taller color chips on preset cards, with indented name and author labels</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-07-21" type="stable">
      <description translate="no">
        <p>First release of Vivid Gradience, a maintained fork of Gradience.</p>
        <ul>
          <li>Builds and runs on the GNOME 50 runtime</li>
          <li>Modernized adaptive interface built on current libadwaita</li>
          <li>New Presets gallery with 39 bundled color schemes</li>
          <li>Searchable, collapsible color categories</li>
          <li>Reworked Theming and Advanced pages</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
