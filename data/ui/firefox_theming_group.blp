using Gtk 4.0;
using Adw 1;

template $GradienceFirefoxThemingGroup: Adw.PreferencesGroup {
  title: _("Firefox Engine");
  description: _("Themes Firefox and its forks — LibreWolf, Waterfox — to match the current preset. Switch on the profiles you want themed; the rest are left exactly as they are.");

  Adw.ExpanderRow firefox-theming-expander {
    title: _("Firefox Engine Options");
    subtitle: _("Install the theme, and what to do with what it wrote");
    expanded: true;

    [action]
    Button firefox-apply-button {
      valign: center;
      label: _("Apply");
      tooltip-text: _("Apply the preset to Firefox");
      clicked => $on_apply_button_clicked();

      styles [
        "suggested-action"
      ]
    }

    Adw.ActionRow profiles-row {
      title: _("Detected Profiles");
      subtitle: _("Searching…");

      [suffix]
      Button install-theme-button {
        valign: center;
        visible: false;
        label: _("Install Theme");
        tooltip-text: _("Install the Firefox GNOME Theme into your profiles");
        clicked => $on_install_theme_clicked();
      }
    }
  }
}

Adw.ActionRow theme-options-row {
  title: _("Theme Options");
  subtitle: _("Optional features of the Firefox GNOME Theme");

  [suffix]
  Button theme_options_button {
    valign: center;
    label: _("Options");
    tooltip-text: _("Turn the Firefox GNOME Theme's optional features on and off");
    clicked => $on_theme_options_clicked();
  }
}

Adw.ActionRow reset-options-row {
  title: _("Preset Colours");
  subtitle: _("The stylesheets the engine writes into each profile");

  [suffix]
  Button reset_theme_button {
    valign: center;
    label: _("Remove Colours");
    tooltip-text: _("Remove the generated stylesheets, keeping the Firefox GNOME Theme installed");
    clicked => $on_reset_theme_clicked();

    styles [
      "destructive-action"
    ]
  }
}

Adw.ActionRow uninstall-row {
  title: _("Firefox GNOME Theme");
  subtitle: _("Installed by Vivid Gradience");
  visible: false;

  [suffix]
  Button uninstall_theme_button {
    valign: center;
    label: _("Uninstall");
    tooltip-text: _("Remove the Firefox GNOME Theme itself from the profiles Vivid Gradience installed it into");
    clicked => $on_uninstall_theme_clicked();

    styles [
      "destructive-action"
    ]
  }
}
