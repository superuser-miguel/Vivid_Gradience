using Gtk 4.0;
using Adw 1;

template $GradienceResetPresetGroup : Adw.PreferencesGroup {
  title: _("Reset and Restore Theming");
  description: _("Reset theming to default, step back to the previous preset, or restore the theme that was installed before Vivid Gradience first ran.");

  Adw.ActionRow {
    title: _("GTK 4/Libadwaita Apps");

    Button restore_libadw_button {
      valign: center;
      icon-name: "edit-undo-symbolic";
      tooltip-text: _("Restore Previous Preset");
      clicked => $on_libadw_restore_button_clicked();
      styles ["flat"]
    }

    Button reset_libadw_button {
      valign: center;
      label: _("Reset");
      tooltip-text: _("Reset Applied Preset");
      clicked => $on_libadw_reset_button_clicked();
      styles ["destructive-action"]
    }
  }

  Adw.ActionRow {
    title: _("GTK 3 Apps");

    Button restore_gtk3_button {
      valign: center;
      icon-name: "edit-undo-symbolic";
      tooltip-text: _("Restore Previous Preset");
      clicked => $on_gtk3_restore_button_clicked();
      styles ["flat"]
    }

    Button reset_gtk3_button {
      valign: center;
      label: _("Reset");
      tooltip-text: _("Reset Applied Preset");
      clicked => $on_gtk3_reset_button_clicked();
      styles ["destructive-action"]
    }
  }

  Adw.ActionRow original_libadw_row {
    title: _("Original GTK 4 Theme");
    visible: false;

    Button restore_original_libadw_button {
      valign: center;
      label: _("Restore");
      tooltip-text: _("Restore the stylesheet that was in place before Vivid Gradience first applied a preset");
      clicked => $on_libadw_restore_original_clicked();
      styles ["flat"]
    }
  }

  Adw.ActionRow original_gtk3_row {
    title: _("Original GTK 3 Theme");
    visible: false;

    Button restore_original_gtk3_button {
      valign: center;
      label: _("Restore");
      tooltip-text: _("Restore the stylesheet that was in place before Vivid Gradience first applied a preset");
      clicked => $on_gtk3_restore_original_clicked();
      styles ["flat"]
    }
  }
}
