<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="gradience">
	<schema id="@APP_ID@" path="/io/github/superuser_miguel/Vivid_Gradience/">
		<key name="window-width" type="i">
			<default>1000</default>
		</key>
		<key name="window-height" type="i">
			<default>700</default>
		</key>
		<key name="window-maximized" type="b">
			<default>false</default>
		</key>
		<key name="window-fullscreen" type="b">
			<default>false</default>
		</key>
		<key name="first-run" type="b">
			<default>true</default>
		</key>
        <key name="last-opened-version" type="s">
			<default>'0.2.2'</default>
		</key>
		<key name="enabled-plugins" type="as">
			<default>[]</default>
		</key>
        <key name="enabled-theme-engines" type="as">
            <default>['shell', 'monet', 'firefox', 'icons', 'desktop']</default>
        </key>
		<key name="user-flatpak-theming-gtk4" type="b">
			<default>false</default>
		</key>
		<key name="global-flatpak-theming-gtk4" type="b">
			<default>false</default>
		</key>
		<key name="user-flatpak-theming-gtk3" type="b">
			<default>false</default>
		</key>
		<key name="global-flatpak-theming-gtk3" type="b">
			<default>false</default>
		</key>
		<key name="repos" type="a{sv}">
			<default>{}</default>
		</key>
		<key name="enabled-repos" type="a{sv}">
			<default>{}</default>
		</key>
		<key name="favourite" type="as">
			<default>[]</default>
		</key>
		<key name="use-jsdelivr" type="b">
			<default>false</default>
		</key>
		<!-- Firefox profiles the engine leaves alone, by directory path.
		     People theme profiles apart on purpose so they can tell one
		     window from another; a preset should not walk over that. -->
		<key name="firefox-skipped-profiles" type="as">
			<default>[]</default>
		</key>
		<!-- Profiles the engine has already made up its mind about, so a
		     profile the user deliberately switched back on is not skipped
		     again the next time its add-on theme is noticed. -->
		<key name="firefox-known-profiles" type="as">
			<default>[]</default>
		</key>
	</schema>
</schemalist>
